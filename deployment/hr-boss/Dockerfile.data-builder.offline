ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

ARG APT_MIRROR
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONIOENCODING=utf-8
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null || true; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip \
    && if [ -n "${PIP_INDEX_URL}" ]; then python -m pip config set global.index-url "${PIP_INDEX_URL}"; fi \
    && if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then python -m pip config set global.extra-index-url "${PIP_EXTRA_INDEX_URL}"; fi \
    && if [ -n "${PIP_TRUSTED_HOST}" ]; then python -m pip config set global.trusted-host "${PIP_TRUSTED_HOST}"; fi

WORKDIR /app
COPY deer-flow/deployment/hr-boss/sync_huoju_hr_data.py /app/deployment/hr-boss/sync_huoju_hr_data.py
COPY deer-flow/backend/scripts/import_huoju_hr_mysql.py /app/backend/scripts/import_huoju_hr_mysql.py
COPY deer-flow/backend/scripts/clean_huoju_hr_mysql.py /app/backend/scripts/clean_huoju_hr_mysql.py
COPY hr-mcp-suite/services/graphrag-mcp /opt/hr-mcp/graphrag-mcp
COPY hr-mcp-suite/data/byog_graphrag /opt/hr-mcp/byog_graphrag

RUN python -m pip install --no-cache-dir \
      pandas \
      openpyxl \
      httpx \
      pymysql \
      sqlalchemy \
      neo4j \
      cryptography \
      python-dotenv \
      -e /opt/hr-mcp/graphrag-mcp \
      -e /opt/hr-mcp/byog_graphrag

CMD ["python", "/app/deployment/hr-boss/sync_huoju_hr_data.py", "--force"]
