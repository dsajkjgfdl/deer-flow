# HR Boss Docker deployment example.
# Copy this file to deployment/hr-boss/.env and adjust paths/secrets on the server.

# Public entrypoint.
PORT=2026

# Build mirrors for restricted or slow networks.
# Pick mirrors reachable from your server. These values are used while building
# Gateway, Frontend, Provisioner, and HR Boss helper images.
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.aliyun.com

# Base images can be overridden for domestic-only networks.
# Prefer a company internal registry for production. Public mirrors are useful
# for short-term testing but may be rate-limited or lag behind upstream.
# Examples:
# UV_IMAGE=ghcr.nju.edu.cn/astral-sh/uv:0.7.20
# NGINX_IMAGE=registry.company.local/docker.io/library/nginx:alpine
# FRONTEND_NODE_IMAGE=registry.company.local/docker.io/library/node:22-alpine
# BACKEND_NODE_IMAGE=registry.company.local/docker.io/library/node:22-bookworm-slim
# PYTHON_IMAGE=registry.company.local/docker.io/library/python:3.12-slim-bookworm
# DOCKER_CLI_IMAGE=registry.company.local/docker.io/library/docker:cli
# MYSQL_IMAGE=registry.company.local/docker.io/library/mysql:8.4
# NEO4J_IMAGE=registry.company.local/docker.io/library/neo4j:5

# DeerFlow runtime paths on the host.
DEER_FLOW_REPO_ROOT=/opt/deer-flow
DEER_FLOW_HOME=/data/deer-flow
DEER_FLOW_CONFIG_PATH=/opt/deer-flow/config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=/opt/deer-flow/extensions_config.hr-boss.json
DEER_FLOW_DOCKER_SOCKET=/var/run/docker.sock
GATEWAY_WORKERS=1

# Required by Next.js production auth. Use a long random value in production.
BETTER_AUTH_SECRET=replace_with_random_hex

# Model keys.
HR_LLM_PROFILE=qwen
QWEN_API_KEY=replace_with_company_qwen_key
QWEN_CHAT_API_BASE=http://36.212.39.231:11435/v1
QWEN_CHAT_MODEL=Qwen3
DEEPSEEK_API_KEY=replace_with_deepseek_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
ALIBABA_API_KEY=replace_with_alibaba_or_dashscope_key

# Huoju HR API source.
# This directory should contain:
# - 火炬hr.Apifox.json
# - 火炬token.Apifox.json
HUOJU_APIFOX_DIR=/data/hr/apifox
HUOJU_HR_APIFOX_FILE=火炬hr.Apifox.json
HUOJU_TOKEN_APIFOX_FILE=火炬token.Apifox.json
HUOJU_API_BASE_URL=http://192.168.180.51:31606
HUOJU_API_TIMEOUT_SECONDS=30
HUOJU_RAW_TABLE_PREFIX=hr_
# Optional: set this to bypass token Apifox login.
# HUOJU_API_TOKEN=

# External MCP/code repositories on the server.
TEXT2CYPHER_REPO=/opt/hr-mcp/text2cypher
GRAPHRAG_MCP_REPO=/opt/hr-mcp/graphrag-mcp
BYOG_GRAPHRAG_ROOT=/data/hr/graphrag/byog_graphrag
HR_TEXT2CYPHER_LOG_DIR=/data/hr/logs/text2cypher
# Shared log level for the independent HTTP MCP services.
HR_MCP_LOG_LEVEL=info
# GraphRAG query deadlines. The Gateway MCP response timeout is 200 seconds.
GRAPHRAG_QUERY_TIMEOUT_SECONDS=90
GRAPHRAG_GLOBAL_PRIMARY_TIMEOUT_SECONDS=120
GRAPHRAG_GLOBAL_FALLBACK_TIMEOUT_SECONDS=45
GRAPHRAG_GLOBAL_TOTAL_TIMEOUT_SECONDS=180

# MySQL used by the rebuild job.
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_DATABASE=huoju_hr
HUOJU_MYSQL_DATABASE=huoju_hr
MYSQL_USER=hr
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_CHARSET=utf8mb4

# Neo4j used by Text2Cypher and the rebuild job.
TEXT2CYPHER_NEO4J_URI=bolt://neo4j:7687
TEXT2CYPHER_NEO4J_USERNAME=neo4j
TEXT2CYPHER_NEO4J_PASSWORD=replace_with_neo4j_password
TEXT2CYPHER_NEO4J_DATABASE=neo4j

# Optional published ports for direct database debugging.
MYSQL_PUBLISHED_PORT=3306
NEO4J_HTTP_PUBLISHED_PORT=7474
NEO4J_BOLT_PUBLISHED_PORT=7687

# Optional WeCom channel.
WECOM_BOT_ID=your_wecom_bot_id
WECOM_BOT_SECRET=your_wecom_bot_secret
